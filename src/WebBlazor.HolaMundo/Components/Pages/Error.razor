@page "/Error"
@using System.Diagnostics

<PageTitle>Algo falló — Hola Mundo</PageTitle>

<h1>Algo falló</h1>

@* El detalle técnico no se le muestra a la persona: filtra información del sistema
   y no dice qué hacer. El identificador del pedido es lo único que se expone, y
   sirve para cruzar el reporte con la traza del servicio. *@
<UnavailableState Title="No pudimos completar el pedido"
                    Body="El service no llegó a resolverlo. Volvé a intentarlo; si vuelve a pasar, avisá con el identificador de abajo."
                    ActionLabel="Volver al inicio"
                    OnRetry="BackToHome" />

@if (ShowRequestId)
{
    <dl class="mq-kv mq-mt-5">
        <div>
            <dt class="mq-kv__clave">Identificador del pedido</dt>
            <dd class="mq-kv__valor" data-testid="identificador-pedido">@RequestId</dd>
        </div>
    </dl>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    private void BackToHome() => Navigation.NavigateTo("/");
}
