@* Insignia de estado. Imprime SIEMPRE el texto: el color no es el único canal. *@

<span class="mq-insignia @CssClass">@Value</span>

@code {
    /// <summary>Rótulo de interfaz del estado, ya concordado en género.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = default!;

    /// <summary>Tono semántico con el que se pinta el par texto + tint.</summary>
    [Parameter] public Tone Tone { get; set; } = Tone.Neutro;

    private string CssClass => Tone switch
    {
        Tone.Exito => "mq-insignia--exito",
        Tone.Atencion => "mq-insignia--atencion",
        Tone.Peligro => "mq-insignia--peligro",
        Tone.Info => "mq-insignia--info",
        _ => string.Empty
    };
}
