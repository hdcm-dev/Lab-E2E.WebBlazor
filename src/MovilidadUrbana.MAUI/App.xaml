<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:MovilidadUrbana.MAUI.Convertidores"
             x:Class="MovilidadUrbana.MAUI.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Movilidad.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:TextoPresenteConverter x:Key="TextoPresente" />
            <conv:NegarConverter x:Key="Negar" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
