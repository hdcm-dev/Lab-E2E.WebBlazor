<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="MovilidadUrbana.MAUI.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Marca}"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="{StaticResource Superficie}"
       Shell.TabBarForegroundColor="{StaticResource Marca}"
       Shell.TabBarTitleColor="{StaticResource Marca}"
       Shell.TabBarUnselectedColor="{StaticResource TextoSecundario}">
    <!-- Dos pestañas, una por módulo: las dos tareas son independientes y se alternan sin perder lo cargado. -->
    <TabBar>
        <Tab Title="Localidades" Icon="tab_localidades.png" Route="localidades">
            <ShellContent x:Name="Localidades" />
        </Tab>
        <Tab Title="Encuesta" Icon="tab_encuesta.png" Route="encuesta">
            <ShellContent x:Name="Encuesta" />
        </Tab>
    </TabBar>
</Shell>
