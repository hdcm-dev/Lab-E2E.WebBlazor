@* El servicio no respondió. La acción de reintento nombra lo que se va a reintentar, no
   «Reintentar» a secas. *@

<section class="mq-aviso-indisponible" role="alert" aria-labelledby="@IdDelTitulo" data-testid="@Testid">
    <h2 id="@IdDelTitulo"><Icono Nombre="@Iconos.Alerta" Tamanio="RolesDeIcono.Tarjeta" /> @Titulo</h2>
    <p class="mq-caption">@Cuerpo</p>
    <button type="button" class="mq-btn mq-btn--secundario mq-mt-3" data-testid="@TestidAccion"
            @onclick="AlReintentar">@AccionRotulo</button>
</section>

@code {
    // Identificador derivado del título: tiene que ser el mismo en el prerenderizado y en
    // el circuito, así que no puede salir de un valor nuevo por render.
    private string IdDelTitulo => "indisponible-" + string.Concat(Titulo.Where(char.IsLetterOrDigit)).ToLowerInvariant();

    [Parameter, EditorRequired] public string Titulo { get; set; } = default!;

    [Parameter, EditorRequired] public string Cuerpo { get; set; } = default!;

    [Parameter, EditorRequired] public string AccionRotulo { get; set; } = default!;

    [Parameter] public EventCallback AlReintentar { get; set; }

    [Parameter] public string? Testid { get; set; }

    [Parameter] public string? TestidAccion { get; set; }
}
