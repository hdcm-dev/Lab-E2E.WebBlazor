@* El servicio no respondió. La acción de reintento nombra lo que se va a reintentar, no
   «Reintentar» a secas. *@

<section class="mq-aviso-indisponible" role="alert" aria-labelledby="@TitleId" data-testid="@Testid">
    <h2 id="@TitleId"><Icon Nombre="@Icons.Alert" Size="IconRoles.Card" /> @Title</h2>
    <p class="mq-caption">@Body</p>
    <button type="button" class="mq-btn mq-btn--secundario mq-mt-3" data-testid="@ActionTestid"
            @onclick="OnRetry">@ActionLabel</button>
</section>

@code {
    // Identificador derivado del título: tiene que ser el mismo en el prerenderizado y en
    // el circuito, así que no puede salir de un valor nuevo por render.
    private string TitleId => "indisponible-" + string.Concat(Title.Where(char.IsLetterOrDigit)).ToLowerInvariant();

    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    [Parameter, EditorRequired] public string Body { get; set; } = default!;

    [Parameter, EditorRequired] public string ActionLabel { get; set; } = default!;

    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public string? Testid { get; set; }

    [Parameter] public string? ActionTestid { get; set; }
}
