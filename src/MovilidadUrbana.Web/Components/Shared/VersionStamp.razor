@* Sello de identidad de versión. El valor lo resuelve el host: el componente no lo compone ni lo
   lee de una constante de la vista. *@
@inject IVersionIdentity Version

<span class="mq-sello-version mq-meta" data-testid="sello-version">
    <Icon Nombre="@Icons.Brand" Size="IconRoles.Row" />
    <span>@Label — @Version.DisplayVersion</span>
    @if (Version.IsPrerelease)
    {
        <Badge Tone="BadgeTone.Atencion">preliminar</Badge>
    }
    @if (Version.UnknownSource)
    {
        <span class="mq-meta">origen indeterminado</span>
    }
</span>

@code {
    [Parameter] public string Label { get; set; } = "Movilidad Urbana";
}
