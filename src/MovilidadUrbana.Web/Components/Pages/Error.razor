@page "/Error"
@using System.Diagnostics
@layout MainLayout

<PageTitle>Movilidad Urbana — Error</PageTitle>

<div class="mq-encabezado">
    <div>
        <h1 data-testid="titulo">Error</h1>
        <p class="mq-caption">La operación no se completó. Volvé a intentar en unos segundos.</p>
    </div>
</div>

@* El identificador no es información del sistema: es lo que permite encontrar el episodio en el
   diagnóstico sin exponer la traza. *@
@if (HayIdentificador)
{
    <p class="mq-caption mq-mb-6">Identificador de la petición: <code>@Identificador</code></p>
}

<a class="mq-btn mq-btn--primario" href="">Volver al inicio</a>

@code {
    [CascadingParameter]
    private HttpContext? ContextoHttp { get; set; }

    private string? Identificador { get; set; }

    private bool HayIdentificador => !string.IsNullOrEmpty(Identificador);

    protected override void OnInitialized() =>
        Identificador = Activity.Current?.Id ?? ContextoHttp?.TraceIdentifier;
}
