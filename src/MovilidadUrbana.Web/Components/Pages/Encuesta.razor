@page "/encuesta"
@page "/encuesta/{Paso:int}"
@* Asistente de varios niveles: el acto es divisible y reanudable dentro de la sesión, y el paso
   vigente está en la dirección para que se pueda verificar de a uno. *@

<PageTitle>Movilidad Urbana — Encuesta</PageTitle>

<div class="mq-encabezado">
    <div>
        <h1 data-testid="titulo">Encuesta de uso del transporte</h1>
        <p class="mq-caption">Tres pasos. Se puede volver atrás sin perder lo cargado.</p>
    </div>
    <span class="mq-ml-auto">
        <Insignia Testid="contador-encuestas">Registradas: @_registradas</Insignia>
    </span>
</div>

<p class="mq-sr-only" role="status" aria-live="polite">@_anuncio</p>

@if (_aviso is { } aviso)
{
    <div class="mq-mb-6">
        <Banda Tono="TonoDeBanda.Error" Testid="aviso">@aviso</Banda>
    </div>
}

@if (_respuesta is null)
{
    <Asistente PasoActual="_paso" Rotulos="Rotulos" AlCambiarPaso="IrAlPasoAsync"
               AlConfirmar="FinalizarAsync" RotuloDeConfirmacion="Registrar la encuesta"
               RotuloEnProceso="Registrando…" Procesando="_procesando">
        <EditForm Model="_modelo" OnSubmit="AvanzarAsync" data-testid="formulario">
            <PasoDeAsistente Numero="1">
                <div class="mq-grilla-campos">
                    <Campo Id="nombre" Rotulo="Nombre y apellido" TestidError="error-nombre"
                           Requisito="@PoliticaDeEncuestas.RequisitoDelNombre" Error="@Error("nombre")">
                        <Control Context="campo">
                            <input class="@campo.ClaseDeInput" id="@campo.Id" type="text"
                                   data-testid="campo-nombre" autocomplete="name"
                                   maxlength="@ReglasDeEncuesta.LargoMaximoDelNombre"
                                   aria-describedby="@campo.Descriptores" value="@_modelo.Nombre"
                                   @oninput="argumentos => _modelo.Nombre = argumentos.Value?.ToString() ?? string.Empty" />
                        </Control>
                    </Campo>

                    <Campo Id="edad" Rotulo="Edad" TestidError="error-edad"
                           Requisito="@PoliticaDeEncuestas.RequisitoDeLaEdad" Error="@Error("edad")">
                        <Control Context="campo">
                            <input class="@campo.ClaseDeInput" id="@campo.Id" type="number"
                                   data-testid="campo-edad" min="@ReglasDeEncuesta.EdadMinima"
                                   max="@ReglasDeEncuesta.EdadMaxima" step="1"
                                   aria-describedby="@campo.Descriptores"
                                   @bind="_modelo.Edad" @bind:event="oninput" />
                        </Control>
                    </Campo>

                    <Campo Id="localidad" Rotulo="Localidad" TestidError="error-localidad"
                           Requisito="@PoliticaDeEncuestas.RequisitoDeLaLocalidad" Error="@Error("localidad")">
                        <Control Context="campo">
                            <select class="@campo.ClaseDeSelect" id="@campo.Id"
                                    data-testid="campo-localidad"
                                    aria-describedby="@campo.Descriptores" @bind="_modelo.Localidad">
                                <option value="">Seleccione…</option>
                                @foreach (var localidad in _localidades)
                                {
                                    <option value="@localidad.Nombre">@localidad.Nombre (@localidad.Provincia)</option>
                                }
                            </select>
                        </Control>
                    </Campo>
                </div>
            </PasoDeAsistente>

            <PasoDeAsistente Numero="2">
                @* Grupo de casillas: el rótulo del grupo es la leyenda, y el error se asocia al
                   grupo entero porque la regla es del conjunto, no de una casilla. *@
                <fieldset aria-describedby="@DescriptoresDeLosMedios">
                    <legend>¿Qué medios utiliza para viajar?</legend>
                    <span class="mq-requisito" id="medios-requisito">@PoliticaDeEncuestas.RequisitoDeLosMedios</span>
                    <div class="mq-opciones" data-testid="grupo-medios">
                        @foreach (var medio in Catalogos.Medios)
                        {
                            <div class="mq-opcion">
                                <input type="checkbox" id="medio-@medio.Clave" data-testid="medio-@medio.Clave"
                                       checked="@_modelo.Medios.Contains(medio.Clave)"
                                       @onchange="argumentos => _modelo.AlternarMedio(medio.Clave, (bool)(argumentos.Value ?? false))" />
                                <label for="medio-@medio.Clave">@medio.Etiqueta</label>
                            </div>
                        }
                    </div>
                    @if (Error("medios") is { } errorDeMedios)
                    {
                        <span class="mq-error-inline mq-mt-2" id="medios-error" data-testid="error-medios">@errorDeMedios</span>
                    }
                </fieldset>

                <div class="mq-mt-6 mq-ancho-38">
                    <Campo Id="frecuencia" Rotulo="Frecuencia de uso" TestidError="error-frecuencia"
                           Requisito="@PoliticaDeEncuestas.RequisitoDeLaFrecuencia" Error="@Error("frecuencia")">
                        <Control Context="campo">
                            <select class="@campo.ClaseDeSelect" id="@campo.Id"
                                    data-testid="campo-frecuencia"
                                    aria-describedby="@campo.Descriptores" @bind="_modelo.Frecuencia">
                                <option value="">Seleccione…</option>
                                @foreach (var frecuencia in Catalogos.Frecuencias)
                                {
                                    <option value="@frecuencia.Clave">@frecuencia.Etiqueta</option>
                                }
                            </select>
                        </Control>
                    </Campo>
                </div>
            </PasoDeAsistente>

            <PasoDeAsistente Numero="3">
                <div class="mq-grilla-campos">
                    <Campo Id="distancia" Rotulo="Distancia diaria (km)" TestidError="error-distancia"
                           Requisito="@PoliticaDeEncuestas.RequisitoDeLaDistancia" Error="@Error("distancia")">
                        <Control Context="campo">
                            <input class="@campo.ClaseDeInput" id="@campo.Id" type="number"
                                   data-testid="campo-distancia" min="@ReglasDeEncuesta.DistanciaMinima"
                                   max="@ReglasDeEncuesta.DistanciaMaxima" step="0.1"
                                   aria-describedby="@campo.Descriptores"
                                   @bind="_modelo.Distancia" @bind:event="oninput" />
                        </Control>
                    </Campo>

                    <Campo Id="minutos" Rotulo="Tiempo de viaje (minutos)" TestidError="error-minutos"
                           Requisito="@PoliticaDeEncuestas.RequisitoDeLosMinutos" Error="@Error("minutos")">
                        <Control Context="campo">
                            <input class="@campo.ClaseDeInput" id="@campo.Id" type="number"
                                   data-testid="campo-minutos" min="@ReglasDeEncuesta.MinutosMinimos"
                                   max="@ReglasDeEncuesta.MinutosMaximos" step="1"
                                   aria-describedby="@campo.Descriptores"
                                   @bind="_modelo.Minutos" @bind:event="oninput" />
                        </Control>
                    </Campo>

                    <Campo Id="motivo" Rotulo="Motivo principal" TestidError="error-motivo"
                           Requisito="@PoliticaDeEncuestas.RequisitoDelMotivo" Error="@Error("motivo")">
                        <Control Context="campo">
                            <select class="@campo.ClaseDeSelect" id="@campo.Id" data-testid="campo-motivo"
                                    aria-describedby="@campo.Descriptores" @bind="_modelo.Motivo">
                                <option value="">Seleccione…</option>
                                @foreach (var motivo in Catalogos.Motivos)
                                {
                                    <option value="@motivo.Clave">@motivo.Etiqueta</option>
                                }
                            </select>
                        </Control>
                    </Campo>
                </div>
            </PasoDeAsistente>
        </EditForm>
    </Asistente>
}
else
{
    @* Estado de éxito de la superficie: la revisión de lo registrado, en filas clave/valor
       recorridas desde el resumen, no escritas a mano en la vista. *@
    <p class="mq-caption mq-mb-6" data-testid="etiqueta-paso">Encuesta completada</p>

    <div class="mq-panel">
        <div class="mq-panel__cuerpo">
            <section data-testid="resumen">
                <Banda Tono="TonoDeBanda.Exito" Testid="mensaje-envio">
                    Encuesta registrada. ¡Gracias por participar!
                </Banda>
                <dl class="mq-kv mq-mt-5">
                    @foreach (var campo in ResumenDeEncuesta.De(_respuesta))
                    {
                        <div>
                            <dt class="mq-kv__clave">@campo.Etiqueta</dt>
                            <dd class="mq-kv__valor" data-testid="resumen-@campo.Clave">@campo.Valor</dd>
                        </div>
                    }
                </dl>
            </section>
        </div>
        <div class="mq-panel__pie">
            <span></span>
            <button type="button" class="mq-btn mq-btn--primario" data-testid="boton-reiniciar"
                    @onclick="ReiniciarAsync">Cargar otra encuesta</button>
        </div>
    </div>
}
