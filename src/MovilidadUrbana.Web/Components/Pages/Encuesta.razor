@page "/encuesta"
@page "/encuesta/{Paso:int}"
@* Asistente de varios niveles: el acto es divisible y reanudable dentro de la sesión, y el paso
   vigente está en la dirección para que se pueda verificar de a uno. *@

<PageTitle>Movilidad Urbana — Encuesta</PageTitle>

<div class="mq-encabezado">
    <div>
        <h1 data-testid="titulo">Encuesta de uso del transporte</h1>
        <p class="mq-caption">Tres pasos. Se puede volver atrás sin perder lo cargado.</p>
    </div>
    <span class="mq-ml-auto">
        <Badge Testid="contador-encuestas">Registradas: @_registradas</Badge>
    </span>
</div>

<p class="mq-sr-only" role="status" aria-live="polite">@_announcement</p>

@if (_notice is { } notice)
{
    <div class="mq-mb-6">
        <Band Tone="BandTone.Error" Testid="aviso">@notice</Band>
    </div>
}

@if (_respuesta is null)
{
    <Wizard CurrentStep="_paso" Labels="Labels" OnStepChange="GoToStepAsync"
               OnConfirm="FinishAsync" ConfirmLabel="Registrar la encuesta"
               BusyLabel="Registrando…" Busy="_busy">
        <EditForm Model="_model" OnSubmit="AdvanceAsync" data-testid="formulario">
            <WizardStep Number="1">
                <div class="mq-grilla-campos">
                    <FormField Id="nombre" Label="Nombre y apellido" ErrorTestid="error-nombre"
                           Requirement="@EncuestaPolicy.RequisitoDelNombre" Error="@Error("nombre")">
                        <Control Context="campo">
                            <input class="@campo.InputClass" id="@campo.Id" type="text"
                                   data-testid="campo-nombre" autocomplete="name"
                                   maxlength="@EncuestaRules.LargoMaximoDelNombre"
                                   aria-describedby="@campo.DescribedBy" value="@_model.Nombre"
                                   @oninput="argumentos => _model.Nombre = argumentos.Value?.ToString() ?? string.Empty" />
                        </Control>
                    </FormField>

                    <FormField Id="edad" Label="Edad" ErrorTestid="error-edad"
                           Requirement="@EncuestaPolicy.RequisitoDeLaEdad" Error="@Error("edad")">
                        <Control Context="campo">
                            <input class="@campo.InputClass" id="@campo.Id" type="number"
                                   data-testid="campo-edad" min="@EncuestaRules.EdadMinima"
                                   max="@EncuestaRules.EdadMaxima" step="1"
                                   aria-describedby="@campo.DescribedBy"
                                   @bind="_model.Edad" @bind:event="oninput" />
                        </Control>
                    </FormField>

                    <FormField Id="localidad" Label="Localidad" ErrorTestid="error-localidad"
                           Requirement="@EncuestaPolicy.RequisitoDeLaLocalidad" Error="@Error("localidad")">
                        <Control Context="campo">
                            <select class="@campo.SelectClass" id="@campo.Id"
                                    data-testid="campo-localidad"
                                    aria-describedby="@campo.DescribedBy" @bind="_model.Localidad">
                                <option value="">Seleccione…</option>
                                @foreach (var localidad in _localidades)
                                {
                                    <option value="@localidad.Nombre">@localidad.Nombre (@localidad.Provincia)</option>
                                }
                            </select>
                        </Control>
                    </FormField>
                </div>
            </WizardStep>

            <WizardStep Number="2">
                @* Grupo de casillas: el rótulo del grupo es la leyenda, y el error se asocia al
                   grupo entero porque la regla es del conjunto, no de una casilla. *@
                <fieldset aria-describedby="@DescriptoresDeLosMedios">
                    <legend>¿Qué medios utiliza para viajar?</legend>
                    <span class="mq-requisito" id="medios-requisito">@EncuestaPolicy.RequisitoDeLosMedios</span>
                    <div class="mq-opciones" data-testid="grupo-medios">
                        @foreach (var medio in Catalogos.Medios)
                        {
                            <div class="mq-opcion">
                                <input type="checkbox" id="medio-@medio.Clave" data-testid="medio-@medio.Clave"
                                       checked="@_model.Medios.Contains(medio.Clave)"
                                       @onchange="argumentos => _model.AlternarMedio(medio.Clave, (bool)(argumentos.Value ?? false))" />
                                <label for="medio-@medio.Clave">@medio.Etiqueta</label>
                            </div>
                        }
                    </div>
                    @if (Error("medios") is { } errorDeMedios)
                    {
                        <span class="mq-error-inline mq-mt-2" id="medios-error" data-testid="error-medios">@errorDeMedios</span>
                    }
                </fieldset>

                <div class="mq-mt-6 mq-ancho-38">
                    <FormField Id="frecuencia" Label="Frecuencia de uso" ErrorTestid="error-frecuencia"
                           Requirement="@EncuestaPolicy.RequisitoDeLaFrecuencia" Error="@Error("frecuencia")">
                        <Control Context="campo">
                            <select class="@campo.SelectClass" id="@campo.Id"
                                    data-testid="campo-frecuencia"
                                    aria-describedby="@campo.DescribedBy" @bind="_model.Frecuencia">
                                <option value="">Seleccione…</option>
                                @foreach (var frecuencia in Catalogos.Frecuencias)
                                {
                                    <option value="@frecuencia.Clave">@frecuencia.Etiqueta</option>
                                }
                            </select>
                        </Control>
                    </FormField>
                </div>
            </WizardStep>

            <WizardStep Number="3">
                <div class="mq-grilla-campos">
                    <FormField Id="distancia" Label="Distancia diaria (km)" ErrorTestid="error-distancia"
                           Requirement="@EncuestaPolicy.RequisitoDeLaDistancia" Error="@Error("distancia")">
                        <Control Context="campo">
                            <input class="@campo.InputClass" id="@campo.Id" type="number"
                                   data-testid="campo-distancia" min="@EncuestaRules.DistanciaMinima"
                                   max="@EncuestaRules.DistanciaMaxima" step="0.1"
                                   aria-describedby="@campo.DescribedBy"
                                   @bind="_model.Distancia" @bind:event="oninput" />
                        </Control>
                    </FormField>

                    <FormField Id="minutos" Label="Tiempo de viaje (minutos)" ErrorTestid="error-minutos"
                           Requirement="@EncuestaPolicy.RequisitoDeLosMinutos" Error="@Error("minutos")">
                        <Control Context="campo">
                            <input class="@campo.InputClass" id="@campo.Id" type="number"
                                   data-testid="campo-minutos" min="@EncuestaRules.MinutosMinimos"
                                   max="@EncuestaRules.MinutosMaximos" step="1"
                                   aria-describedby="@campo.DescribedBy"
                                   @bind="_model.Minutos" @bind:event="oninput" />
                        </Control>
                    </FormField>

                    <FormField Id="motivo" Label="Motivo principal" ErrorTestid="error-motivo"
                           Requirement="@EncuestaPolicy.RequisitoDelMotivo" Error="@Error("motivo")">
                        <Control Context="campo">
                            <select class="@campo.SelectClass" id="@campo.Id" data-testid="campo-motivo"
                                    aria-describedby="@campo.DescribedBy" @bind="_model.Motivo">
                                <option value="">Seleccione…</option>
                                @foreach (var motivo in Catalogos.Motivos)
                                {
                                    <option value="@motivo.Clave">@motivo.Etiqueta</option>
                                }
                            </select>
                        </Control>
                    </FormField>
                </div>
            </WizardStep>
        </EditForm>
    </Wizard>
}
else
{
    @* Estado de éxito de la superficie: la revisión de lo registrado, en filas clave/valor
       recorridas desde el resumen, no escritas a mano en la vista. *@
    <p class="mq-caption mq-mb-6" data-testid="etiqueta-paso">Encuesta completada</p>

    <div class="mq-panel">
        <div class="mq-panel__cuerpo">
            <section data-testid="resumen">
                <Band Tone="BandTone.Exito" Testid="mensaje-envio">
                    Encuesta registrada. ¡Gracias por participar!
                </Band>
                <dl class="mq-kv mq-mt-5">
                    @foreach (var campo in ResumenDeEncuesta.De(_respuesta))
                    {
                        <div>
                            <dt class="mq-kv__clave">@campo.Etiqueta</dt>
                            <dd class="mq-kv__valor" data-testid="resumen-@campo.Clave">@campo.Valor</dd>
                        </div>
                    }
                </dl>
            </section>
        </div>
        <div class="mq-panel__pie">
            <span></span>
            <button type="button" class="mq-btn mq-btn--primario" data-testid="boton-reiniciar"
                    @onclick="ResetAsync">Cargar otra encuesta</button>
        </div>
    </div>
}
