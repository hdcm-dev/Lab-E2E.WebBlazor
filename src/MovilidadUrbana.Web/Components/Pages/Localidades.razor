@page "/localidades"
@* ABM clásico, en el orden canónico de la superficie: encabezado, banda de resultado, bloque de
   indisponible, formulario de edición y colección con sus estados. El alta no está en un modal:
   es el panel de edición de la propia superficie, con su título, su acción de retorno y su
   estado de envío. *@

<PageTitle>Movilidad Urbana — Localidades</PageTitle>

<div class="mq-encabezado">
    <div>
        <h1 data-testid="titulo">Localidades</h1>
        <p class="mq-caption">Cada fila se edita en el panel de la izquierda.</p>
    </div>
</div>

@* Región activa: lo que cambia sin que la persona lo mire, se anuncia. *@
<p class="mq-sr-only" role="status" aria-live="polite">@_announcement</p>

@if (_notice is { } notice)
{
    <div class="mq-mb-6">
        <Band Tone="notice.Tone" Testid="aviso">@notice.Message</Band>
    </div>
}

@if (_state is SurfaceState.Indisponible)
{
    <UnavailableState Title="No pudimos traer las localidades"
                        Body="El service no respondió. Lo que ves puede estar desactualizado."
                        ActionLabel="Reintentar traer las localidades"
                        OnRetry="LoadAsync"
                        Testid="indisponible" ActionTestid="boton-reintentar" />
}
else
{
    <div class="mq-columnas-abm">
        <div class="mq-panel">
            <div class="mq-panel__cabecera" data-testid="titulo-formulario">
                @(_model.IsEdit ? "Editar localidad" : "Alta de localidad")
            </div>
            <div class="mq-panel__cuerpo">
                <EditForm Model="_model" OnSubmit="SaveAsync" data-testid="formulario">
                    <div class="mq-grilla-campos">
                        <FormField Id="nombre" Label="Nombre" ErrorTestid="error-nombre"
                               Requirement="@LocalidadPolicy.RequisitoDelNombre" Error="@Error("nombre")">
                            <Control Context="campo">
                                <input class="@campo.InputClass" id="@campo.Id" type="text"
                                       data-testid="campo-nombre" autocomplete="off"
                                       maxlength="@LocalidadRules.LargoMaximoDelNombre"
                                       aria-describedby="@campo.DescribedBy" @ref="_campoDelNombre"
                                       value="@_model.Nombre"
                                       @oninput="argumentos => _model.Nombre = argumentos.Value?.ToString() ?? string.Empty" />
                            </Control>
                        </FormField>

                        <FormField Id="provincia" Label="Provincia" ErrorTestid="error-provincia"
                               Requirement="@LocalidadPolicy.RequisitoDeLaProvincia" Error="@Error("provincia")">
                            <Control Context="campo">
                                <select class="@campo.SelectClass" id="@campo.Id"
                                        data-testid="campo-provincia"
                                        aria-describedby="@campo.DescribedBy" @bind="_model.Provincia">
                                    <option value="">Seleccione…</option>
                                    @foreach (var provincia in Catalogos.Provincias)
                                    {
                                        <option value="@provincia">@provincia</option>
                                    }
                                </select>
                            </Control>
                        </FormField>

                        <FormField Id="codigoPostal" Label="Código postal" ErrorTestid="error-codigo-postal"
                               Requirement="@LocalidadPolicy.RequisitoDelCodigoPostal" Error="@Error("codigoPostal")">
                            <Control Context="campo">
                                <input class="@campo.InputClass" id="@campo.Id" type="text"
                                       data-testid="campo-codigo-postal" autocomplete="postal-code"
                                       inputmode="numeric" placeholder="3400"
                                       aria-describedby="@campo.DescribedBy"
                                       value="@_model.CodigoPostal"
                                       @oninput="argumentos => _model.CodigoPostal = argumentos.Value?.ToString() ?? string.Empty" />
                            </Control>
                        </FormField>

                        <FormField Id="habitantes" Label="Habitantes" ErrorTestid="error-habitantes"
                               Requirement="@LocalidadPolicy.RequisitoDeLosHabitantes" Error="@Error("habitantes")">
                            <Control Context="campo">
                                @* `oninput` y no `onchange`: `fill()` de Playwright dispara `input`, y con el
                                   enlace por defecto el valor no llegaría al servidor hasta perder el foco. *@
                                <input class="@campo.InputClass" id="@campo.Id" type="number"
                                       data-testid="campo-habitantes" min="@LocalidadRules.HabitantesMinimos"
                                       step="1" aria-describedby="@campo.DescribedBy"
                                       @bind="_model.Habitantes" @bind:event="oninput" />
                            </Control>
                        </FormField>
                    </div>

                    <div class="mq-acciones-pie mq-mt-6">
                        <button type="button" class="mq-btn mq-btn--secundario" data-testid="boton-cancelar"
                                @onclick="Cancel">Cancelar</button>
                        <button type="submit" class="mq-btn mq-btn--primario" data-testid="boton-guardar"
                                disabled="@_busy">
                            @if (_busy)
                            {
                                <span class="mq-spinner"></span><text>Guardando…</text>
                            }
                            else
                            {
                                <Icon Nombre="@Icons.Tilde" Size="IconRoles.Row" />
                                <text>@(_model.IsEdit ? "Actualizar" : "Guardar")</text>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="mq-panel">
            <div class="mq-panel__cabecera">
                <span>Listado</span>
                <Badge Testid="contador">@_visible.Count</Badge>
                @if (HasFilter)
                {
                    <span class="mq-caption">de @_all.Count</span>
                }
            </div>

            <div class="mq-panel__cuerpo">
                <div class="mq-filtros">
                    <div class="mq-campo mq-campo-busqueda">
                        <label for="buscar">Buscar por nombre o código postal</label>
                        <span class="mq-campo-busqueda__icono">
                            <Icon Nombre="@Icons.Buscar" />
                        </span>
                        <input class="mq-input" id="buscar" type="search" data-testid="campo-buscar"
                               placeholder="nombre o código postal" value="@_texto" @oninput="OnSearch" />
                    </div>
                    <div class="mq-campo">
                        <label for="filtro-provincia">Provincia</label>
                        <select class="mq-select mq-ancho-38" id="filtro-provincia"
                                data-testid="filtro-provincia" @bind="_provincia" @bind:after="ApplyFilter">
                            <option value="">todas</option>
                            @foreach (var provincia in Catalogos.Provincias)
                            {
                                <option value="@provincia">@provincia</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <Grid TItem="Localidad" Items="_visible" State="_state"
                    AccessibleTitle="Localidades cargadas, con su provincia, su código postal y sus habitantes"
                    Clave="localidad => localidad.Id"
                    BodyTestid="cuerpo-tabla" RowTestid="fila" CardTestid="tarjeta">
                <Columns>
                    <GridColumn TItem="Localidad" Title="Nombre" IsRowHeader="true"
                                     Testid="celda-nombre">
                        <Template Context="localidad">
                            <span class="mq-iniciales" aria-hidden="true">@Initials(localidad.Nombre)</span>@localidad.Nombre
                        </Template>
                    </GridColumn>
                    <GridColumn TItem="Localidad" Title="Provincia" Testid="celda-provincia">
                        <Template Context="localidad">@localidad.Provincia</Template>
                    </GridColumn>
                    <GridColumn TItem="Localidad" Title="CP" Testid="celda-codigo-postal">
                        <Template Context="localidad">@localidad.CodigoPostal</Template>
                    </GridColumn>
                    <GridColumn TItem="Localidad" Title="Habitantes" IsNumeric="true"
                                     Testid="celda-habitantes">
                        <Template Context="localidad">@localidad.Habitantes.ToString("N0")</Template>
                    </GridColumn>
                </Columns>
                <Actions Context="localidad">
                    <button type="button" class="mq-btn mq-btn--fila mq-btn--marca" data-testid="boton-editar"
                            aria-label="@($"Editar la localidad {localidad.Nombre}")"
                            @onclick="() => Edit(localidad)">
                        <Icon Nombre="@Icons.Edit" Size="IconRoles.Row" />Editar
                    </button>
                    <button type="button" class="mq-btn mq-btn--fila mq-btn--destructivo"
                            data-testid="boton-eliminar"
                            aria-label="@($"Eliminar la localidad {localidad.Nombre}")"
                            @onclick="() => ConfirmDeleteAsync(localidad)">
                        <Icon Nombre="@Icons.Delete" Size="IconRoles.Row" />Eliminar
                    </button>
                </Actions>
                <Empty>
                    @* Vacío de colección: la acción que corresponde es cargar la primera. *@
                    <EmptyState Title="Todavía no hay localidades"
                                 Body="Cuando cargues la primera, va a aparecer acá con su provincia y sus habitantes."
                                 ActionLabel="Cargar la primera localidad"
                                 OnAction="FocusNameAsync"
                                 Testid="sin-datos" ActionTestid="boton-cargar-la-primera" />
                </Empty>
                <NoResults>
                    @* Vacío de filtrado: hay localidades y ninguna coincide. Otra acción. *@
                    <EmptyState Title="Ninguna localidad coincide con el filtro"
                                 Body="Hay localidades cargadas; ninguna cumple lo que buscaste."
                                 ActionLabel="Limpiar el filtro"
                                 OnAction="ClearFilter"
                                 Testid="sin-resultados" ActionTestid="boton-limpiar-filtro" />
                </NoResults>
            </Grid>
        </div>
    </div>
}
