@page "/localidades"
@* ABM clásico, en el orden canónico de la superficie: encabezado, banda de resultado, bloque de
   indisponible, formulario de edición y colección con sus estados. El alta no está en un modal:
   es el panel de edición de la propia superficie, con su título, su acción de retorno y su
   estado de envío. *@

<PageTitle>Movilidad Urbana — Localidades</PageTitle>

<div class="mq-encabezado">
    <div>
        <h1 data-testid="titulo">Localidades</h1>
        <p class="mq-caption">Cada fila se edita en el panel de la izquierda.</p>
    </div>
</div>

@* Región activa: lo que cambia sin que la persona lo mire, se anuncia. *@
<p class="mq-sr-only" role="status" aria-live="polite">@_anuncio</p>

@if (_aviso is { } aviso)
{
    <div class="mq-mb-6">
        <Banda Tono="aviso.Tono" Testid="aviso">@aviso.Mensaje</Banda>
    </div>
}

@if (_estado is EstadoDeSuperficie.Indisponible)
{
    <EstadoIndisponible Titulo="No pudimos traer las localidades"
                        Cuerpo="El servicio no respondió. Lo que ves puede estar desactualizado."
                        AccionRotulo="Reintentar traer las localidades"
                        AlReintentar="CargarAsync"
                        Testid="indisponible" TestidAccion="boton-reintentar" />
}
else
{
    <div class="mq-columnas-abm">
        <div class="mq-panel">
            <div class="mq-panel__cabecera" data-testid="titulo-formulario">
                @(_modelo.EsEdicion ? "Editar localidad" : "Alta de localidad")
            </div>
            <div class="mq-panel__cuerpo">
                <EditForm Model="_modelo" OnSubmit="GuardarAsync" data-testid="formulario">
                    <div class="mq-grilla-campos">
                        <Campo Id="nombre" Rotulo="Nombre" TestidError="error-nombre"
                               Requisito="@PoliticaDeLocalidades.RequisitoDelNombre" Error="@Error("nombre")">
                            <Control Context="campo">
                                <input class="@campo.ClaseDeInput" id="@campo.Id" type="text"
                                       data-testid="campo-nombre" autocomplete="off"
                                       maxlength="@ReglasDeLocalidad.LargoMaximoDelNombre"
                                       aria-describedby="@campo.Descriptores" @ref="_campoDelNombre"
                                       value="@_modelo.Nombre"
                                       @oninput="argumentos => _modelo.Nombre = argumentos.Value?.ToString() ?? string.Empty" />
                            </Control>
                        </Campo>

                        <Campo Id="provincia" Rotulo="Provincia" TestidError="error-provincia"
                               Requisito="@PoliticaDeLocalidades.RequisitoDeLaProvincia" Error="@Error("provincia")">
                            <Control Context="campo">
                                <select class="@campo.ClaseDeSelect" id="@campo.Id"
                                        data-testid="campo-provincia"
                                        aria-describedby="@campo.Descriptores" @bind="_modelo.Provincia">
                                    <option value="">Seleccione…</option>
                                    @foreach (var provincia in Catalogos.Provincias)
                                    {
                                        <option value="@provincia">@provincia</option>
                                    }
                                </select>
                            </Control>
                        </Campo>

                        <Campo Id="codigoPostal" Rotulo="Código postal" TestidError="error-codigo-postal"
                               Requisito="@PoliticaDeLocalidades.RequisitoDelCodigoPostal" Error="@Error("codigoPostal")">
                            <Control Context="campo">
                                <input class="@campo.ClaseDeInput" id="@campo.Id" type="text"
                                       data-testid="campo-codigo-postal" autocomplete="postal-code"
                                       inputmode="numeric" placeholder="3400"
                                       aria-describedby="@campo.Descriptores"
                                       value="@_modelo.CodigoPostal"
                                       @oninput="argumentos => _modelo.CodigoPostal = argumentos.Value?.ToString() ?? string.Empty" />
                            </Control>
                        </Campo>

                        <Campo Id="habitantes" Rotulo="Habitantes" TestidError="error-habitantes"
                               Requisito="@PoliticaDeLocalidades.RequisitoDeLosHabitantes" Error="@Error("habitantes")">
                            <Control Context="campo">
                                @* `oninput` y no `onchange`: `fill()` de Playwright dispara `input`, y con el
                                   enlace por defecto el valor no llegaría al servidor hasta perder el foco. *@
                                <input class="@campo.ClaseDeInput" id="@campo.Id" type="number"
                                       data-testid="campo-habitantes" min="@ReglasDeLocalidad.HabitantesMinimos"
                                       step="1" aria-describedby="@campo.Descriptores"
                                       @bind="_modelo.Habitantes" @bind:event="oninput" />
                            </Control>
                        </Campo>
                    </div>

                    <div class="mq-acciones-pie mq-mt-6">
                        <button type="button" class="mq-btn mq-btn--secundario" data-testid="boton-cancelar"
                                @onclick="Cancelar">Cancelar</button>
                        <button type="submit" class="mq-btn mq-btn--primario" data-testid="boton-guardar"
                                disabled="@_procesando">
                            @if (_procesando)
                            {
                                <span class="mq-spinner"></span><text>Guardando…</text>
                            }
                            else
                            {
                                <Icono Nombre="@Iconos.Tilde" Tamanio="RolesDeIcono.Fila" />
                                <text>@(_modelo.EsEdicion ? "Actualizar" : "Guardar")</text>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="mq-panel">
            <div class="mq-panel__cabecera">
                <span>Listado</span>
                <Insignia Testid="contador">@_visibles.Count</Insignia>
                @if (HayFiltro)
                {
                    <span class="mq-caption">de @_todas.Count</span>
                }
            </div>

            <div class="mq-panel__cuerpo">
                <div class="mq-filtros">
                    <div class="mq-campo mq-campo-busqueda">
                        <label for="buscar">Buscar por nombre o código postal</label>
                        <span class="mq-campo-busqueda__icono">
                            <Icono Nombre="@Iconos.Buscar" />
                        </span>
                        <input class="mq-input" id="buscar" type="search" data-testid="campo-buscar"
                               placeholder="nombre o código postal" value="@_texto" @oninput="AlBuscar" />
                    </div>
                    <div class="mq-campo">
                        <label for="filtro-provincia">Provincia</label>
                        <select class="mq-select mq-ancho-38" id="filtro-provincia"
                                data-testid="filtro-provincia" @bind="_provincia" @bind:after="Refiltrar">
                            <option value="">todas</option>
                            @foreach (var provincia in Catalogos.Provincias)
                            {
                                <option value="@provincia">@provincia</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <Grilla TItem="Localidad" Items="_visibles" Estado="_estado"
                    TituloAccesible="Localidades cargadas, con su provincia, su código postal y sus habitantes"
                    Clave="localidad => localidad.Id"
                    TestidCuerpo="cuerpo-tabla" TestidFila="fila" TestidTarjeta="tarjeta">
                <Columnas>
                    <ColumnaDeGrilla TItem="Localidad" Titulo="Nombre" EsEncabezadoDeFila="true"
                                     Testid="celda-nombre">
                        <Plantilla Context="localidad">
                            <span class="mq-iniciales" aria-hidden="true">@Iniciales(localidad.Nombre)</span>@localidad.Nombre
                        </Plantilla>
                    </ColumnaDeGrilla>
                    <ColumnaDeGrilla TItem="Localidad" Titulo="Provincia" Testid="celda-provincia">
                        <Plantilla Context="localidad">@localidad.Provincia</Plantilla>
                    </ColumnaDeGrilla>
                    <ColumnaDeGrilla TItem="Localidad" Titulo="CP" Testid="celda-codigo-postal">
                        <Plantilla Context="localidad">@localidad.CodigoPostal</Plantilla>
                    </ColumnaDeGrilla>
                    <ColumnaDeGrilla TItem="Localidad" Titulo="Habitantes" EsNumerica="true"
                                     Testid="celda-habitantes">
                        <Plantilla Context="localidad">@localidad.Habitantes.ToString("N0")</Plantilla>
                    </ColumnaDeGrilla>
                </Columnas>
                <Acciones Context="localidad">
                    <button type="button" class="mq-btn mq-btn--fila mq-btn--marca" data-testid="boton-editar"
                            aria-label="@($"Editar la localidad {localidad.Nombre}")"
                            @onclick="() => Editar(localidad)">
                        <Icono Nombre="@Iconos.Editar" Tamanio="RolesDeIcono.Fila" />Editar
                    </button>
                    <button type="button" class="mq-btn mq-btn--fila mq-btn--destructivo"
                            data-testid="boton-eliminar"
                            aria-label="@($"Eliminar la localidad {localidad.Nombre}")"
                            @onclick="() => PedirBajaAsync(localidad)">
                        <Icono Nombre="@Iconos.Eliminar" Tamanio="RolesDeIcono.Fila" />Eliminar
                    </button>
                </Acciones>
                <Vacio>
                    @* Vacío de colección: la acción que corresponde es cargar la primera. *@
                    <EstadoVacio Titulo="Todavía no hay localidades"
                                 Cuerpo="Cuando cargues la primera, va a aparecer acá con su provincia y sus habitantes."
                                 AccionRotulo="Cargar la primera localidad"
                                 AlAccionar="EnfocarElNombreAsync"
                                 Testid="sin-datos" TestidAccion="boton-cargar-la-primera" />
                </Vacio>
                <SinResultados>
                    @* Vacío de filtrado: hay localidades y ninguna coincide. Otra acción. *@
                    <EstadoVacio Titulo="Ninguna localidad coincide con el filtro"
                                 Cuerpo="Hay localidades cargadas; ninguna cumple lo que buscaste."
                                 AccionRotulo="Limpiar el filtro"
                                 AlAccionar="LimpiarElFiltro"
                                 Testid="sin-resultados" TestidAccion="boton-limpiar-filtro" />
                </SinResultados>
            </Grilla>
        </div>
    </div>
}
