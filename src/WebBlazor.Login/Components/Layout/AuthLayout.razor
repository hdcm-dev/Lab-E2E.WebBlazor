@* Shell de acceso: sin sesión no hay navegación que ofrecer, así que no hay chrome.
   La superficie conserva su encabezado de primer nivel: la ausencia de navegación
   no puede dejar la página sin estructura semántica. *@
@inherits LayoutComponentBase

<div class="mq-lienzo">
    <main id="mq-main" class="mq-tarjeta-acceso" tabindex="-1">
        <span class="mq-identidad">
            <Icon Nombre="@Icons.Brand" Size="IconRoles.Card" />
            Ingreso
        </span>
        @Body
    </main>

    <VersionStamp Placement="StampPlacement.Lienzo" />
</div>
