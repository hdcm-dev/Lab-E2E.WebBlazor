@* Estado vacío. Es una invitación a actuar, no un adorno: siempre lleva la acción
   siguiente. El vacío de colección y el vacío de filtrado son estados distintos y
   se resuelven con dos instancias con acciones distintas. *@

<section class="mq-vacio" aria-labelledby="@_titleId">
    <Icon Nombre="@Icons.Empty" Size="IconRoles.Navigation" />
    <h2 id="@_titleId">@Title</h2>
    <p class="mq-prosa">@Body</p>

    @if (!string.IsNullOrEmpty(ActionLabel))
    {
        @if (!string.IsNullOrEmpty(ActionHref))
        {
            <a class="mq-btn mq-btn--primario mq-mt-5" href="@ActionHref">@ActionLabel</a>
        }
        else
        {
            <button type="button" class="mq-btn mq-btn--secundario mq-mt-5"
                    @onclick="OnAction">@ActionLabel</button>
        }
    }
</section>

@code {
    /// <summary>Qué falta, dicho desde el lado de la persona.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    /// <summary>Qué va a pasar cuando haya datos.</summary>
    [Parameter] public string? Body { get; set; }

    /// <summary>Verbo de la acción siguiente. Nombra la acción exacta.</summary>
    [Parameter] public string? ActionLabel { get; set; }

    /// <summary>Destino, cuando la acción siguiente es una navegación.</summary>
    [Parameter] public string? ActionHref { get; set; }

    /// <summary>Manejador, cuando la acción siguiente ocurre en esta misma superficie.</summary>
    [Parameter] public EventCallback OnAction { get; set; }

    private readonly string _titleId = $"vacio-{Guid.NewGuid():n}";
}
