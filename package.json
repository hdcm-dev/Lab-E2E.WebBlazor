{
  "name": "lab-e2e-webblazor",
  "version": "1.0.0",
  "private": true,
  "description": "Demostración de pruebas E2E con Playwright sobre una aplicación .NET Blazor interactive server",
  "scripts": {
    "publicar": "scripts/publicar.sh",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:depurar": "playwright test --debug",
    "reporte": "playwright show-report",
    "codegen": "playwright codegen http://127.0.0.1:4173"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
